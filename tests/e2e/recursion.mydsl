// Recursion: factorial, Fibonacci, mutual recursion, recursion through vector arguments.
function int factorial(int n) {
    if (n <= 1) then { return 1; };
    return n * factorial(n - 1);
};
function int fib(int n) {
    if (n < 2) then { return n; } else { return fib(n - 1) + fib(n - 2); };
};
function bool even(int n) {
    if (n == 0) then { return true; };
    return odd(n - 1);
};
function bool odd(int n) {
    if (n == 0) then { return false; };
    return even(n - 1);
};
function int sum_from(intvector 4 v, int start) {
    if (start >= 4) then { return 0; };
    return v[start] + sum_from(v, start + 1);
};
Print(factorial(10));
Print(fib(15));
Print(even(9));
Print(odd(9));
Print(sum_from([1, 2, 3, 4], 0));
Print(sum_from([1, 2, 3, 4], 2));
