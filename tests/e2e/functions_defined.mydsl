// Function definitions are checked statically and registered; they only run when called.
function int square(int x) {
    return x * x;
};
function float mean(floatvector 3 v) {
    float sum := 0.0;
    for (i := 0, i < 3, 1) { sum := sum + v[i]; };
    return sum / 3.0;
};
function bool even(int n) {
    if (n == 0) then { return true; } else { return odd(n - 1); };
};
function bool odd(int n) {
    if (n == 0) then { return false; } else { return even(n - 1); };
};
int a := 7;
Print(a);
Print([1, 2, 3]);
