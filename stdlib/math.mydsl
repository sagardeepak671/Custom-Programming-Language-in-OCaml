// MyDSL standard library: integer arithmetic.   import "stdlib/math.mydsl";
//
// All functions take and return int (64-bit, overflow is a runtime error). The float versions
// live in fmath.mydsl with an _f suffix, because MyDSL has no overloading. An argument outside
// a function's domain stops the program with error(...): the message names the function, the
// rule and the offending value, and the call trace shows where your program called it.

function int square(int x) {
    return x * x;
};

function int cube(int x) {
    return x * x * x;
};

function int min(int a, int b) {
    if (a < b) then { return a; };
    return b;
};

function int max(int a, int b) {
    if (a > b) then { return a; };
    return b;
};

// x limited to the range low..high; low must not exceed high.
function int clamp(int x, int low, int high) {
    if (low > high) then { error("clamp: low must not exceed high, but low is " + to_string(low) + " and high is " + to_string(high)); };
    if (x < low) then { return low; };
    if (x > high) then { return high; };
    return x;
};

// -1, 0 or 1.
function int sign(int x) {
    if (x < 0) then { return -1; };
    if (x > 0) then { return 1; };
    return 0;
};

function bool is_even(int x) {
    return x % 2 == 0;
};

function bool is_odd(int x) {
    return x % 2 != 0;
};

// base raised to a non-negative exponent (power(0, 0) is 1); overflow is a runtime error.
function int power(int base, int exponent) {
    if (exponent < 0) then { error("power: the exponent must not be negative, but it is " + to_string(exponent) + " (for negative exponents use power_f from fmath.mydsl)"); };
    int result := 1;
    int factor := base;
    int remaining := exponent;
    while (remaining > 0) {
        if (remaining % 2 == 1) then { result := result * factor; };
        remaining := remaining / 2;
        if (remaining > 0) then { factor := factor * factor; };
    };
    return result;
};

// Greatest common divisor, never negative; gcd(0, 0) is 0.
function int gcd(int a, int b) {
    // Euclid's algorithm works on the signs as given ('%' keeps the remainder small), and the
    // sign is removed at the end, so the smallest int is accepted (abs of it would overflow).
    int x := a;
    int y := b;
    while (y != 0) {
        int r := x % y;
        x := y;
        y := r;
    };
    return abs(x);
};

// Least common multiple, never negative; 0 when either argument is 0.
function int lcm(int a, int b) {
    if (a == 0 || b == 0) then { return 0; };
    return abs(a / gcd(a, b) * b);
};

// n! for 0 <= n <= 20 (21! does not fit in an int).
function int factorial(int n) {
    if (n < 0) then { error("factorial: the argument must not be negative, but n is " + to_string(n)); };
    if (n > 20) then { error("factorial: " + to_string(n) + "! does not fit in a 64-bit int (the largest is 20!)"); };
    int result := 1;
    for (i := 2, i <= n, 1) { result := result * i; };
    return result;
};

// The n-th Fibonacci number (0, 1, 1, 2, 3, ...) for 0 <= n <= 92 (fibonacci(93) does not fit in an int).
function int fibonacci(int n) {
    if (n < 0) then { error("fibonacci: the index must not be negative, but n is " + to_string(n)); };
    if (n > 92) then { error("fibonacci: fibonacci(" + to_string(n) + ") does not fit in a 64-bit int (the largest index is 92)"); };
    if (n == 0) then { return 0; };
    int previous := 0;
    int current := 1;
    for (i := 1, i < n, 1) {
        int next := previous + current;
        previous := current;
        current := next;
    };
    return current;
};

// The integer square root: the largest s with s * s <= n, for n >= 0.
function int isqrt(int n) {
    if (n < 0) then { error("isqrt: the argument must not be negative, but n is " + to_string(n)); };
    if (n < 2) then { return n; };
    int x := n / 2 + 1;            // >= sqrt(n), so Newton's steps decrease towards the root
    int y := (x + n / x) / 2;
    while (y < x) {
        x := y;
        y := (x + n / x) / 2;
    };
    return x;
};

// Division rounding towards minus infinity (Python's //), unlike '/' which truncates:
// div_floor(-7, 2) is -4. The divisor must not be 0.
function int div_floor(int a, int b) {
    if (b == 0) then { error("div_floor: the divisor must not be 0 (dividing " + to_string(a) + ")"); };
    int q := a / b;
    if (a % b != 0 && (a < 0) != (b < 0)) then { q := q - 1; };
    return q;
};

// The remainder of div_floor: it has the sign of the divisor (mod_floor(-7, 2) is 1), unlike '%'.
function int mod_floor(int a, int b) {
    if (b == 0) then { error("mod_floor: the divisor must not be 0 (dividing " + to_string(a) + ")"); };
    return a - div_floor(a, b) * b;
};

function bool is_prime(int n) {
    if (n < 2) then { return false; };
    if (n < 4) then { return true; };
    if (n % 2 == 0) then { return false; };
    int d := 3;
    while (d <= n / d) {
        if (n % d == 0) then { return false; };
        d := d + 2;
    };
    return true;
};

// The binomial coefficient "n choose k" for 0 <= k <= n; a result that does not fit in an int
// (from binomial(67, 33) on) is an overflow error.
function int binomial(int n, int k) {
    if (n < 0 || k < 0 || k > n) then { error("binomial: needs 0 <= k <= n, but n is " + to_string(n) + " and k is " + to_string(k)); };
    int smaller := min(k, n - k);
    int result := 1;
    for (i := 1, i <= smaller, 1) {
        // result is C(n - smaller + i - 1, i - 1); the next value is result * m / i with
        // m = n - smaller + i. Dividing by i in two exact steps keeps every intermediate value
        // at most the final one, so only results that do not fit overflow.
        int m := n - smaller + i;
        int common := gcd(result, i);
        result := result / common * (m / (i / common));
    };
    return result;
};

// The number of decimal digits of n (the sign is not counted; 0 has one digit).
function int digit_count(int n) {
    if (n == 0) then { return 1; };
    int remaining := n;
    int count := 0;
    while (remaining != 0) {
        remaining := remaining / 10;
        count := count + 1;
    };
    return count;
};

// The sum of the decimal digits of n (the sign is ignored).
function int digit_sum(int n) {
    int remaining := n;
    int sum := 0;
    while (remaining != 0) {
        sum := sum + abs(remaining % 10);
        remaining := remaining / 10;
    };
    return sum;
};
