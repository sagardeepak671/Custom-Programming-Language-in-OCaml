// while with a compound condition, for loops whose counter/step change, nested loops.
int n := 0;
while (n < 100 && n % 7 != 6) { n := n + 1; };
Print(n);                                        // 6
for (i := 0, i < 10, 1) {
    Print(i);
    if (i == 3) then { i := 7; };                // the step is added to the changed value: 8 next
};
int count := 0;
for (i := 0, i < 3, 1) {
    for (j := i, j < 3, 1) { count := count + 1; };
};
Print(count);                                    // 3 + 2 + 1 = 6
int k := 1;
for (i := 0, i < 5, k) { Print(i); k := k + 1; };  // step re-evaluated: i = 0, 2, then 5 stops
