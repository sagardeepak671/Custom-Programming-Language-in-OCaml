// Recursion inside a module, direct and mutual; uses math_utils through its own import.
import "math_utils.mydsl";
function int factorial(int n) {
    if (n <= 1) then { return 1; };
    return n * factorial(n - 1);
};
function bool is_even(int n) {
    if (n == 0) then { return true; };
    return is_odd(n - 1);
};
function bool is_odd(int n) {
    if (n == 0) then { return false; };
    return is_even(n - 1);
};
function int sum_of_squares(int n) {
    if (n == 0) then { return 0; };
    return square(n) + sum_of_squares(n - 1);
};
