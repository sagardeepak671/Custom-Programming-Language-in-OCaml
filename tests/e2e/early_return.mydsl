// A return inside nested blocks and loops ends the call at once; later statements are skipped.
function int first_negative(intvector 5 v) {
    for (i := 0, i < 5, 1) {
        if (v[i] < 0) then {
            Print(i);
            return v[i];
        };
    };
    Print(-1);
    return 0;
};
function int countdown(int n) {
    while (true) {
        {
            n := n - 1;
            if (n == 0) then { return 100; };
        };
    };
    return -1;
};
Print(first_negative([3, 1, -4, 1, -5]));
Print(first_negative([3, 1, 4, 1, 5]));
Print(countdown(3));
