  11       | WHILE LPAREN expr RPAREN stmt
  12       | LBRACE stmt_list RBRACE
  13       | expr

  14  var_type : TYPE_BOOL
  15           | TYPE_INT
  16           | TYPE_FLOAT
  17           | INT_TYPE_VECTOR INT_VAL
  18           | FLOAT_TYPE_VECTOR INT_VAL
  19           | INT_TYPE_MATRIX INT_VAL COMMA INT_VAL
