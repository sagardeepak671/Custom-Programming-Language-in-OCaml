// Integer helpers from the standard library: run with  ./mydsl stdlib/examples/number_facts.mydsl
import "../math.mydsl";

int n := 360;
Print(square(12));                       // Int(144)
Print(power(2, 40));                     // Int(1099511627776)
Print(min(n, 100));                      // Int(100)
Print(max(n, 100));                      // Int(360)
Print(clamp(n, 0, 255));                 // Int(255)
Print(gcd(n, 84));                       // Int(12)
Print(lcm(4, 6));                        // Int(12)
Print(factorial(20));                    // Int(2432902008176640000): the largest that fits
Print(fibonacci(50));                    // Int(12586269025)
Print(isqrt(n));                         // Int(18), because 18 * 18 = 324 <= 360 < 361
Print(is_prime(360));                    // Bool(false)
Print(is_prime(359));                    // Bool(true)
Print(binomial(10, 3));                  // Int(120)
Print(div_floor(-7, 2));                 // Int(-4), while -7 / 2 truncates to -3
Print(mod_floor(-7, 2));                 // Int(1), while -7 % 2 is -1
Print(digit_count(n));                   // Int(3)
Print(digit_sum(n));                     // Int(9)
Print(sign(-n) * cube(3));               // Int(-27)
