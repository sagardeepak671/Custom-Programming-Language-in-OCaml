// MyDSL standard library: floating-point arithmetic.   import "stdlib/fmath.mydsl";
//
// All functions take and return float (IEEE double); the _f suffix keeps them apart from the
// int versions in math.mydsl, because MyDSL has no overloading. The language has no sqrt, exp,
// log or trigonometric builtins, so they are computed here in MyDSL: sqrt_f by Newton's
// method, exp_f, ln_f, sin_f and cos_f by series after range reduction. They agree with a C
// library to about 1e-14 relative (sqrt_f to 1 ulp; sin_f/cos_f to about 1e-15 absolute for
// |x| up to 1e6); compare results with a tolerance, as for every float (README
// "Floating-point results"). A result that is not finite is a runtime error of the language
// ("Float overflow"); an argument outside a function's domain stops the program with
// error(...): the message names the function, the rule and the offending value.

function float pi() {
    return 3.141592653589793;
};

// Euler's number e.
function float euler() {
    return 2.718281828459045;
};

function float square_f(float x) {
    return x * x;
};

function float cube_f(float x) {
    return x * x * x;
};

function float min_f(float a, float b) {
    if (a < b) then { return a; };
    return b;
};

function float max_f(float a, float b) {
    if (a > b) then { return a; };
    return b;
};

// x limited to the range low..high; low must not exceed high.
function float clamp_f(float x, float low, float high) {
    if (low > high) then { error("clamp_f: low must not exceed high, but low is " + to_string(low) + " and high is " + to_string(high)); };
    if (x < low) then { return low; };
    if (x > high) then { return high; };
    return x;
};

// -1.0, 0.0 or 1.0.
function float sign_f(float x) {
    if (x < 0.0) then { return -1.0; };
    if (x > 0.0) then { return 1.0; };
    return 0.0;
};

// Every float of magnitude 2^52 or more is already an integer (it has no fraction bits), so
// the rounding functions return such an x unchanged; smaller values go through to_int.
function bool has_no_fraction_f(float x) {
    return abs(x) >= 4503599627370496.0;
};

// The largest integral value <= x.
function float floor_f(float x) {
    if (has_no_fraction_f(x)) then { return x; };
    float truncated := to_float(to_int(x));
    if (truncated > x) then { return truncated - 1.0; };
    return truncated;
};

// The smallest integral value >= x.
function float ceil_f(float x) {
    if (has_no_fraction_f(x)) then { return x; };
    float truncated := to_float(to_int(x));
    if (truncated < x) then { return truncated + 1.0; };
    return truncated;
};

// The nearest integral value, halves rounded away from zero: round_f(2.5) is 3.0, round_f(-2.5) is -3.0.
function float round_f(float x) {
    if (x < 0.0) then { return -round_f(-x); };
    // Not floor_f(x + 0.5): for 0.49999999999999994 that sum rounds up to 1.0. The distance
    // to the floor is computed exactly, so the comparison with 0.5 is reliable.
    float down := floor_f(x);
    if (x - down >= 0.5) then { return down + 1.0; };
    return down;
};

// The fractional part x - floor_f(x), in [0, 1).
function float fract_f(float x) {
    return x - floor_f(x);
};

function bool is_integer_f(float x) {
    return floor_f(x) == x;
};

// Linear interpolation: a at t = 0.0, b at t = 1.0 (t is not limited to that range).
function float lerp_f(float a, float b, float t) {
    return a + (b - a) * t;
};

// Whether a and b differ by at most tolerance (compare floats this way, not with ==).
function bool approx_equal_f(float a, float b, float tolerance) {
    return abs(a - b) <= tolerance;
};

// The square root of x >= 0, by Newton's method from a guess that is never below the root.
function float sqrt_f(float x) {
    if (x < 0.0) then { error("sqrt_f: the argument must not be negative, but x is " + to_string(x)); };
    if (x == 0.0) then { return 0.0; };
    float guess := x;
    if (x < 1.0) then { guess := 1.0; };
    float next := 0.5 * (guess + x / guess);
    while (next < guess) {
        guess := next;
        next := 0.5 * (guess + x / guess);
    };
    return guess;
};

// The cube root of x (any sign), by Newton's method from a guess that is never below the root.
function float cbrt_f(float x) {
    if (x < 0.0) then { return -cbrt_f(-x); };
    if (x == 0.0) then { return 0.0; };
    float guess := sqrt_f(x);       // >= cbrt(x) for x >= 1, and small enough to be squared
    if (x < 1.0) then { guess := 1.0; };
    float next := (2.0 * guess + x / (guess * guess)) / 3.0;
    while (next < guess) {
        guess := next;
        next := (2.0 * guess + x / (guess * guess)) / 3.0;
    };
    return guess;
};

// sqrt(a * a + b * b) without overflowing for large arguments (the squares are taken of the
// values scaled by the larger magnitude, so hypot_f(1e200, 1e200) is fine).
function float hypot_f(float a, float b) {
    float larger := max_f(abs(a), abs(b));
    if (larger == 0.0) then { return 0.0; };
    float p := a / larger;
    float q := b / larger;
    return larger * sqrt_f(p * p + q * q);
};

// base raised to an integer exponent of any sign, by repeated squaring: exact for exact
// results (powers of 2, small ints), otherwise with a relative error of about |exponent| times
// 1e-16 (pow_f is more accurate for large exponents). A negative exponent gives 1 / base^n, so
// power_f(0.0, -1) divides by zero and a result below about 1e-308 (base^n above the float
// range) is a Float overflow although tiny denormals would exist.
function float power_f(float base, int exponent) {
    if (exponent < 0) then { return 1.0 / power_f(base, -exponent); };
    float result := 1.0;
    float factor := base;
    int remaining := exponent;
    while (remaining > 0) {
        if (remaining % 2 == 1) then { result := result * factor; };
        remaining := remaining / 2;
        if (remaining > 0) then { factor := factor * factor; };
    };
    return result;
};

// e raised to x, for x <= 709 (the result of a larger x does not fit); below about -708 the result is 0.0.
function float exp_f(float x) {
    if (x > 709.0) then { error("exp_f: exp(" + to_string(x) + ") does not fit in a float (the argument must be at most 709)"); };
    if (x < -708.0) then { return 0.0; };
    // x = k * ln 2 + r with |r| <= (ln 2) / 2, then exp(x) = 2^k * exp(r). ln 2 is split into
    // a high part with few bits (so k * ln2_high is exact) and a low correction.
    float ln2_high := 0.6931471803691238;
    float ln2_low := 1.9082149292705877e-10;
    int k := to_int(round_f(x / 0.6931471805599453));
    float r := (x - to_float(k) * ln2_high) - to_float(k) * ln2_low;
    float term := 1.0;
    float sum := 1.0;
    for (i := 1, i <= 25, 1) {
        term := term * r / to_float(i);
        sum := sum + term;
    };
    return sum * power_f(2.0, k);
};

// The natural logarithm of x > 0.
function float ln_f(float x) {
    if (x <= 0.0) then { error("ln_f: the argument must be positive, but x is " + to_string(x)); };
    // x = m * 2^k with m in [1/sqrt 2, sqrt 2), then ln x = k ln 2 + ln m, and
    // ln m = 2 atanh(z) = 2 (z + z^3/3 + z^5/5 + ...) with z = (m - 1) / (m + 1), |z| < 0.18.
    float m := x;
    int k := 0;
    while (m >= 1.4142135623730951) { m := m * 0.5; k := k + 1; };
    while (m < 0.7071067811865476) { m := m * 2.0; k := k - 1; };
    float z := (m - 1.0) / (m + 1.0);
    float z_squared := z * z;
    float term := z;
    float sum := 0.0;
    for (i := 0, i < 30, 1) {
        sum := sum + term / to_float(2 * i + 1);
        term := term * z_squared;
    };
    return 2.0 * sum + to_float(k) * 0.6931471805599453;
};

function float log2_f(float x) {
    return ln_f(x) / 0.6931471805599453;
};

function float log10_f(float x) {
    return ln_f(x) / 2.302585092994046;
};

// base raised to a real exponent: base > 0, or base == 0.0 with exponent >= 0.0 (a negative
// base is outside the domain; use power_f for integer exponents, it is also more accurate:
// exp(exponent * ln base) carries a relative error of about |exponent * ln base| * 1e-16).
function float pow_f(float base, float exponent) {
    if (base > 0.0) then { return exp_f(exponent * ln_f(base)); };
    if (base == 0.0 && exponent > 0.0) then { return 0.0; };
    if (base == 0.0 && exponent == 0.0) then { return 1.0; };
    if (base == 0.0) then { error("pow_f: 0.0 cannot be raised to the negative exponent " + to_string(exponent)); };
    error("pow_f: the base must not be negative, but it is " + to_string(base) + " (for an integer exponent use power_f)");
};

// x in radians reduced to about [-pi, pi]: x - k * 2 pi with k = floor((x + pi) / 2 pi). 2 pi
// is split into a high part with 33 significant bits (k times it is exact while |k| < 2^20,
// i.e. |x| up to about 6e6) and a low correction, so the reduction of moderate arguments is
// accurate to the last bit; beyond that the error grows in proportion to |x| (about 1e-7 at
// 1e9). Larger angles are rejected: a float that large has no bits left for the fraction of a
// turn, so any result would be meaningless.
function float reduce_angle_f(float x) {
    if (abs(x) > 1e9) then {
        error("reduce_angle_f: the angle " + to_string(x) + " is too large to reduce accurately (sin_f, cos_f and tan_f accept angles up to 1e9 in magnitude)");
    };
    float two_pi_high := 6.28318530693650245668;
    float two_pi_low := 2.43084020260247689973e-10;
    float k := floor_f((x + pi()) / 6.283185307179586);
    return (x - k * two_pi_high) - k * two_pi_low;
};

// Sine of x in radians, by the Taylor series of the reduced angle.
function float sin_f(float x) {
    float r := reduce_angle_f(x);
    float r_squared := r * r;
    float term := r;
    float sum := r;
    for (i := 1, i <= 20, 1) {
        term := -term * r_squared / to_float((2 * i) * (2 * i + 1));
        sum := sum + term;
    };
    return sum;
};

// Cosine of x in radians.
function float cos_f(float x) {
    float r := reduce_angle_f(x);
    float r_squared := r * r;
    float term := 1.0;
    float sum := 1.0;
    for (i := 1, i <= 20, 1) {
        term := -term * r_squared / to_float((2 * i - 1) * (2 * i));
        sum := sum + term;
    };
    return sum;
};

// Tangent of x in radians.
function float tan_f(float x) {
    return sin_f(x) / cos_f(x);
};

function float degrees_f(float radians) {
    return radians * 180.0 / pi();
};

function float radians_f(float degrees) {
    return degrees * pi() / 180.0;
};
