Print(0.1 + 0.2);                     // prints 0.3 (15 significant digits) ...
Print(0.1 + 0.2 == 0.3);              // ... but is not equal to 0.3
Print(abs(0.1 + 0.2 - 0.3) < 1e-12);  // compare with a tolerance instead
Print(1.0 / 3.0);
Print(2.5e3);
Print(1e-5);
Print(to_int(7.9) + to_int(-7.9));    // 7 + -7 = 0 (truncation towards zero)
Print(to_float(7) / 2.0);             // 3.5
Print(-1.5 * -1.5);                   // 2.25
