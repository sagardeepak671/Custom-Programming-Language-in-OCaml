intvector 3 a := [1, 2, 3];
intvector 3 b := [4, 5, 6];
Print(a + b);                          // [5, 7, 9]
Print(b - a);                          // [3, 3, 3]
Print(a * 2 + b);                      // [6, 9, 12]
Print(b / 2);                          // [2, 2, 3]: integer division per element
Print(dotprod_vec(a, b));              // 4 + 10 + 18 = 32
Print(abs([3, 4]));                    // 5.0
Print(inv_vec(a));                     // [3, 2, 1]
Print(a == inv_vec(inv_vec(a)));       // true
Print(is_zero(a - a));                 // true
Print(angle_vec([1, 0], [0, 1]));      // pi / 2
Print(angle_vec([2., 2.], [1., 1.]));  // 0.0 exactly (parallel)
a[0] := a[2] * 10;                     // [30, 2, 3]
Print(a);
int sum := 0;
for (i := 0, i < 3, 1) { sum := sum + a[i] * b[i]; };   // 120 + 10 + 18 = 148
Print(sum);
floatvector 2 f := (2 [1.5, -2.0]);
Print(f * 2.0);                        // [3.0, -4.0]
Print(to_float(b) / 4.0);              // [1.0, 1.25, 1.5]
Print(abs(-f));                        // sqrt(2.25 + 4) = 2.5
